# ==============================================================================
# A&H IMPEX - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ah_impex_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:your_secure_postgres_password@localhost:5432/ah_impex_db
USE_SQLITE_FALLBACK=False

# ==============================================================================
# Email Configuration
# ==============================================================================
# OPTION A: Brevo HTTP API (Recommended for Render - 100% Free 300 emails/day, Port 443 HTTPS)
# Get free API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-api-key-here

# OPTION B: Resend HTTP API (Fast & Free 3,000 emails/month, Port 443 HTTPS)
# Get free API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# OPTION C: Standard SMTP (Note: Render blocks ports 25, 465, 587 on free tier)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Email Inboxes
DEFAULT_FROM_EMAIL=A&H IMPEX Export <your_verified_sender@gmail.com>
COMPANY_NOTIFICATION_EMAIL=your_inbox_email@gmail.com
