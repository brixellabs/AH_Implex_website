# ==============================================================================
# A&H IMPEX - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ah_impex_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgres://postgres:your_secure_postgres_password@localhost:5432/ah_impex_db
USE_SQLITE_FALLBACK=False

# Email Credentials (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=A&H Impex Global Export <your_email@gmail.com>
COMPANY_NOTIFICATION_EMAIL=info@ah-impex.com
